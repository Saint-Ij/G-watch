# Copy to .env and export the variables for the services you are running.
# The common key fallback is X_API_KEY, but each service supports its own key.

GWATCH_URL=http://localhost:3000
GWATCH_TIMEOUT=3
RUN_ON_START=false

# Legitimate services
DELIVERY_X_API_KEY=
PAYMENT_ANALYTICS_X_API_KEY=
MARKETING_X_API_KEY=

# Malicious services
COMPROMISED_DELIVERY_X_API_KEY=
MALICIOUS_SCRAPER_X_API_KEY=
